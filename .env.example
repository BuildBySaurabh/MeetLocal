# ---- Signaling server (apps/signaling) ----
SIGNALING_PORT=8787
SIGNALING_HOST=0.0.0.0
# Comma-separated list of allowed browser origins. Required in production.
ALLOWED_ORIGINS=http://localhost:5173
# Set to "production" to enforce origin checks strictly (no missing Origin header).
NODE_ENV=development

# ---- Web app (apps/web) — Vite exposes only VITE_* variables ----
VITE_SIGNALING_URL=wss://localhost:8787
# Comma-separated STUN servers. Contacting a STUN server reveals your public IP to it.
VITE_STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN relay (placeholders only; never commit real credentials).
VITE_TURN_URL=turn:global.relay.metered.ca:80  
VITE_TURN_USERNAME=de87622924d47a58f42513fe
VITE_TURN_CREDENTIAL=Jhon5IRfwDwgmoqk

# ---- Signaling server extras ----
# Set to "true" only when running behind a reverse proxy you control (uses X-Forwarded-For for per-IP limits).
TRUST_PROXY=false
MAX_ROOMS=1000

# ---- Optional local-AI overrides (apps/web). Defaults are fine for most setups. ----
VITE_TRANSCRIPTION_MODEL=onnx-community/whisper-tiny.en
# Host serving the Whisper files; if you change it, add its origin to the CSP (see docs/DEPLOYMENT.md).
# VITE_TRANSCRIPTION_MODEL_HOST=
# Ollama must be on this machine; non-local endpoints are refused by the app.
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=llama3.2
# Self-hosted face landmarker model URL (default: apps/web/public/models/face_landmarker.task).
# VITE_FACE_MODEL_URL=
# Self-hosted background (selfie segmentation) model URL (default: apps/web/public/models/selfie_segmenter.tflite).
# VITE_SEGMENTER_MODEL_URL=
